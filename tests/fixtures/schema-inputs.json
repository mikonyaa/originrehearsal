{
  "minimal": {
    "schemaVersion": 1,
    "id": "minimal-input",
    "old": { "dir": "old", "buildId": "old-v1" },
    "new": { "dir": "new", "buildId": "new-v2" },
    "app": { "buildSelector": "html", "buildAttribute": "data-app-build", "readySelector": "[data-app-ready]" },
    "hooks": "./hooks.mjs",
    "seedInputs": null,
    "storage": { "localStorageKeys": ["key"], "indexedDB": [] }
  },
  "cases": [
    { "id": "empty-default-objects", "set": [["limits", {}], ["gateway", {}]], "schema": true, "runtime": true },
    { "id": "partial-defaults", "set": [["limits", {"maxRecordsPerStore": 3}], ["gateway", {"port": 65535}]], "schema": true, "runtime": true },
    { "id": "lower-bounds", "set": [["limits", {"phaseTimeoutMs": 500,"maxRecordsPerStore": 1,"maxSnapshotBytes": 256}]], "schema": true, "runtime": true },
    { "id": "upper-bounds", "set": [["limits", {"phaseTimeoutMs": 120000,"maxRecordsPerStore": 100000,"maxSnapshotBytes": 50000000}]], "schema": true, "runtime": true },
    { "id": "unknown-root", "set": [["userDataDir", "ordinary-profile"]], "schema": false, "runtime": false },
    { "id": "unknown-app", "set": [["app.extra", true]], "schema": false, "runtime": false },
    { "id": "unknown-old", "set": [["old.extra", true]], "schema": false, "runtime": false },
    { "id": "unknown-new", "set": [["new.extra", true]], "schema": false, "runtime": false },
    { "id": "unknown-limits", "set": [["limits", {"extra": 1}]], "schema": false, "runtime": false },
    { "id": "unknown-gateway", "set": [["gateway", {"extra": 1}]], "schema": false, "runtime": false },
    { "id": "unknown-storage", "set": [["storage.extra", true]], "schema": false, "runtime": false },
    { "id": "unknown-database", "set": [["storage.indexedDB", [{"name": "db", "stores": ["s"], "extra": true}]]], "schema": false, "runtime": false },
    { "id": "timeout-small", "set": [["limits", {"phaseTimeoutMs": 499}]], "schema": false, "runtime": false },
    { "id": "timeout-large", "set": [["limits", {"phaseTimeoutMs": 120001}]], "schema": false, "runtime": false },
    { "id": "records-zero", "set": [["limits", {"maxRecordsPerStore": 0}]], "schema": false, "runtime": false },
    { "id": "records-large", "set": [["limits", {"maxRecordsPerStore": 100001}]], "schema": false, "runtime": false },
    { "id": "records-fractional", "set": [["limits", {"maxRecordsPerStore": 1.5}]], "schema": false, "runtime": false },
    { "id": "bytes-small", "set": [["limits", {"maxSnapshotBytes": 255}]], "schema": false, "runtime": false },
    { "id": "bytes-large", "set": [["limits", {"maxSnapshotBytes": 50000001}]], "schema": false, "runtime": false },
    { "id": "port-negative", "set": [["gateway", {"port": -1}]], "schema": false, "runtime": false },
    { "id": "port-large", "set": [["gateway", {"port": 65536}]], "schema": false, "runtime": false },
    { "id": "no-numeric-coercion", "set": [["gateway", {"port": "0"}]], "schema": false, "runtime": false },
    { "id": "empty-name", "set": [["storage.localStorageKeys", [""]]], "schema": false, "runtime": false },
    { "id": "empty-stores", "set": [["storage.indexedDB", [{"name": "db", "stores": []}]]], "schema": false, "runtime": false },
    { "id": "duplicate-local-key", "set": [["storage.localStorageKeys", ["key", "key"]]], "schema": false, "runtime": false },
    { "id": "duplicate-store", "set": [["storage.indexedDB", [{"name": "db", "stores": ["s", "s"]}]]], "schema": false, "runtime": false },
    { "id": "duplicate-database-object", "set": [["storage.indexedDB", [{"name": "db", "stores": ["s"]}, {"name": "db", "stores": ["s"]}]]], "schema": false, "runtime": false },
    { "id": "duplicate-database-name", "set": [["storage.indexedDB", [{"name": "db", "stores": ["s"]}, {"name": "db", "stores": ["other"]}]]], "schema": true, "runtime": false, "runtimeOnly": "Database names must be unique even when store lists differ." },
    { "id": "same-build-id", "set": [["new.buildId", "old-v1"]], "schema": true, "runtime": false, "runtimeOnly": "OLD and NEW IDs must differ." },
    { "id": "no-targets", "set": [["storage.localStorageKeys", []]], "schema": true, "runtime": false, "runtimeOnly": "Declare at least one storage target." },
    { "id": "path-without-slash", "set": [["app.path", "page"]], "schema": false, "runtime": false }
  ]
}
